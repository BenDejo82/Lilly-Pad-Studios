<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>4.12.7</Version>
  <Author>Lilly Pad Studios (from the owner's manuals)</Author>
 </Creator>
 <Manufacturer>Betopper</Manufacturer>
 <Model>LM30A</Model>
 <Type>Moving Head</Type>
 <Channel Name="Tilt motor 1">
  <Group Byte="0">Tilt</Group>
  <Capability Min="0" Max="255">0 to 135 degrees</Capability>
 </Channel>
 <Channel Name="Tilt motor 2">
  <Group Byte="0">Tilt</Group>
  <Capability Min="0" Max="255">0 to 135 degrees</Capability>
 </Channel>
 <Channel Name="Dimmer" Preset="IntensityMasterDimmer"/>
 <Channel Name="Strobe">
  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="9" Preset="ShutterOpen">No strobe</Capability>
  <Capability Min="10" Max="255" Preset="StrobeSlowToFast">Strobe slow to fast</Capability>
 </Channel>
 <Channel Name="Red bar 1" Preset="IntensityRed"/>
 <Channel Name="Green bar 1" Preset="IntensityGreen"/>
 <Channel Name="Blue bar 1" Preset="IntensityBlue"/>
 <Channel Name="White bar 1" Preset="IntensityWhite"/>
 <Channel Name="White bar 2" Preset="IntensityWhite"/>
 <Channel Name="Blue bar 2" Preset="IntensityBlue"/>
 <Channel Name="Green bar 2" Preset="IntensityGreen"/>
 <Channel Name="Red bar 2" Preset="IntensityRed"/>
 <Channel Name="Reset / sound">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="129">No function</Capability>
  <Capability Min="130" Max="199">No function</Capability>
  <Capability Min="200" Max="249" Preset="ResetAll">Reset (hold 3 s)</Capability>
  <Capability Min="250" Max="255">Sound control (random)</Capability>
 </Channel>
 <Channel Name="Effect">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="7">No effect</Capability>
  <Capability Min="8" Max="255">Effects 1-25</Capability>
 </Channel>
 <Channel Name="Effect speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255">Effect speed quick to slow</Capability>
 </Channel>
 <Channel Name="Reset / sound (7 ch)">
  <Group Byte="0">Maintenance</Group>
  <Capability Min="0" Max="199">No function</Capability>
  <Capability Min="200" Max="249" Preset="ResetAll">Reset (hold 3 s)</Capability>
  <Capability Min="250" Max="255">Sound control (random)</Capability>
 </Channel>
 <Mode Name="13 Channel">
  <Physical>
   <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
   <Dimensions Weight="3" Width="160" Height="280" Depth="125"/>
   <Lens Name="Other" DegreesMin="10" DegreesMax="10"/>
   <Focus Type="Head" PanMax="0" TiltMax="135"/>
   <Technical PowerConsumption="30" DmxConnector="3-pin"/>
  </Physical>
  <Channel Number="0">Tilt motor 1</Channel>
  <Channel Number="1">Tilt motor 2</Channel>
  <Channel Number="2">Dimmer</Channel>
  <Channel Number="3">Strobe</Channel>
  <Channel Number="4">Red bar 1</Channel>
  <Channel Number="5">Green bar 1</Channel>
  <Channel Number="6">Blue bar 1</Channel>
  <Channel Number="7">White bar 1</Channel>
  <Channel Number="8">White bar 2</Channel>
  <Channel Number="9">Blue bar 2</Channel>
  <Channel Number="10">Green bar 2</Channel>
  <Channel Number="11">Red bar 2</Channel>
  <Channel Number="12">Reset / sound</Channel>
 </Mode>
 <Mode Name="7 Channel">
  <Physical>
   <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
   <Dimensions Weight="3" Width="160" Height="280" Depth="125"/>
   <Lens Name="Other" DegreesMin="10" DegreesMax="10"/>
   <Focus Type="Head" PanMax="0" TiltMax="135"/>
   <Technical PowerConsumption="30" DmxConnector="3-pin"/>
  </Physical>
  <Channel Number="0">Tilt motor 1</Channel>
  <Channel Number="1">Tilt motor 2</Channel>
  <Channel Number="2">Dimmer</Channel>
  <Channel Number="3">Strobe</Channel>
  <Channel Number="4">Effect</Channel>
  <Channel Number="5">Effect speed</Channel>
  <Channel Number="6">Reset / sound (7 ch)</Channel>
 </Mode>
</FixtureDefinition>
